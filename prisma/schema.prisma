generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Inquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  destination String?
  start       String?
  end         String?
  message     String?
  createdAt   DateTime @default(now())
  status      String   @default("NEW")
}

model MembershipApplication {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String?
  country         String?
  occupation      String?
  travelInterests String?
  reason          String?
  referral        String?
  status          String    @default("PENDING")
  adminNotes      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  reviewedAt      DateTime?
}
